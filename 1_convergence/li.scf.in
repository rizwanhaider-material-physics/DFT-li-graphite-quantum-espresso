&CONTROL
  calculation = 'scf'
  prefix = 'li'
  outdir = './tmp'
  pseudo_dir = '../pseudo'
/
&SYSTEM
  ibrav = 3
  celldm(1) = 6.63
  nat = 1
  ntyp = 1
  ecutwfc = 40.0
  ecutrho = 320.0
  occupations = 'smearing'
  smearing = 'marzari-vanderbilt'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-8
/
ATOMIC_SPECIES
  Li 6.94 li_pbe_v1.4.uspp.F.UPF
ATOMIC_POSITIONS (alat)
  Li 0.0 0.0 0.0
K_POINTS automatic
  12 12 12 0 0 0
