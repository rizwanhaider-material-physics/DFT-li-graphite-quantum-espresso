&CONTROL
  calculation = 'vc-relax'
  prefix = 'li3z'
  outdir = './tmp'
  pseudo_dir = '../pseudo'
  etot_conv_thr = 1.0d-6
  forc_conv_thr = 1.0d-4
/
&SYSTEM
  ibrav = 3
  celldm(1) = 6.63
  nat = 1
  ntyp = 1
  ecutwfc = 45.0
  ecutrho = 360.0
  occupations = 'smearing'
  smearing = 'marzari-vanderbilt'
  degauss = 0.02
  vdw_corr = 'grimme-d3'
  dftd3_version = 3
/
&ELECTRONS
  conv_thr = 1.0d-10
/
&IONS
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.1
/
ATOMIC_SPECIES
  Li 6.94 li_pbe_v1.4.uspp.F.UPF
ATOMIC_POSITIONS (alat)
  Li 0.0 0.0 0.0
K_POINTS automatic
  16 16 16 0 0 0
